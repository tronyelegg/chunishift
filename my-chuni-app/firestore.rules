rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 개인 플레이 기록 및 프로필: 로그인한 본인(auth.uid == userId)만 조회 및 저장 가능
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 그 외 접근은 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

